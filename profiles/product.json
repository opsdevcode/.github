{
  "profile": "product",
  "visibility": "private",
  "default_branch": "main",
  "pull_request_required": true,
  "approvals_required": 1,
  "approvals_solo_exception_allowed": true,
  "conversation_resolution": true,
  "force_push_allowed": false,
  "branch_deletion_allowed": false,
  "required_checks": "any",
  "secret_scanning": true,
  "push_protection": true,
  "dependabot_alerts": true,
  "workflow_permissions": "contents:read",
  "release_model": "product_owned_immutable_publish",
  "deploy_owner": "infra_via_product_trigger",
  "notes": "Relay is an internal runtime; visibility remains private. Repave may keep product-specific check names until an explicit ruleset migration."
}
