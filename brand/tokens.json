{
  "schema_version": 1,
  "thesis": {
    "name": "The governed section",
    "idea": "OpsDevCode is drawn as an engineering section through a living system: open joints, planes, and witness marks. Products are different readings of the same cut, not four mascots."
  },
  "construction": {
    "grid": 32,
    "stroke": 1.5,
    "cap": "square",
    "join": "miter",
    "fill": "none",
    "corner_open_gap": 6,
    "clearspace_units": 6,
    "minimum_mark_px": 16
  },
  "company": {
    "ink": "#1A1F1C",
    "paper": "#F3EFE6",
    "paper_muted": "#E7E1D4",
    "rule": "#C9C2B3",
    "rule_strong": "#8F8778",
    "text": "#1A1F1C",
    "text_secondary": "#3F433F",
    "text_muted": "#5C615A"
  },
  "products": {
    "repave": { "accent": "#C4841A", "on_paper": "#1A1F1C" },
    "overpass": { "accent": "#1A7A72", "on_paper": "#1A1F1C" },
    "toll": { "accent": "#2B5F9E", "on_paper": "#1A1F1C" },
    "dispatch": { "accent": "#5B4A8A", "on_paper": "#1A1F1C" }
  },
  "typography": {
    "display": "IBM Plex Serif",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "license": "OFL-1.1 via Google Fonts / IBM Plex"
  },
  "endorsement": "{product} — by OpsDevCode"
}
